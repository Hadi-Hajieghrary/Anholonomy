\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {IV-}0a}Independent-plant check.}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Outside the leading-order domain: the measured amplitude departs from the $\tau ^2$ law by 10\% only at $\tau \approx 10$ --- an order of magnitude beyond the operating grid ($\tau \le 1.6$), where the relative departure stays below $3.4\times 10^{-3}$. The theorem is a small-$\tau $ statement and this is its measured boundary.}}{4}{}\protected@file@percent }
\newlabel{fig:domain}{{6}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Extension arms. (a)\nobreakspace  {}Slope across 20 random taut formations: $1.9993 \pm 0.0000$ --- formation-invariant. (b)\nobreakspace  {}Remainder constant over 220 draws: uniformly tight $O(\tau ^3)$ truncation. (c)\nobreakspace  {}Zero-commutator pairs at $\ge 1$\,rad separation all satisfy $C_i = C_j$ to $10^{-16}$: the protected class is a level set. (d)\nobreakspace  {}Coefficient ratio $\to 1$ as $\tau \to 0$.}}{4}{}\protected@file@percent }
\newlabel{fig:ext}{{7}{4}}
