\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-A}}Gauge pinning (Cor.\nobreakspace  {}5.2 in closed loop)}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Three phases of the GNSS-denied transit (supplementary video S2). Left: gauge free --- the five ghost caissons (each agent's own load estimate) drift \emph  {coherently}, overlapping each other while offset from truth. Middle: the beacon pins one agent; the fleet is mid-convergence. Right: converged through the turn. Single illustrative run, median-$D_{ss}$ seed by the documented selection rule.}}{5}{}\protected@file@percent }
\newlabel{fig:montage}{{3}{5}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces BHT scorecard: 50 dogleg transits per arm (dock window means). Ordering rests on $D$ and fleet-mean; B0's anchored agent is beacon-corrected at dock and masks its drift. All arms fail the $<0.5$\,m criterion at plan-faithful acquisition (see text).}}{5}{}\protected@file@percent }
\newlabel{tab:scorecard}{{III}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-B}}Docking outcomes at distribution level, and the v2 remedy}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The recorded 450\,s dogleg transit (from the committed \texttt  {hero\_dogleg\_series.npz}). (a)\nobreakspace  {}Truth: barge + 5 vessels, turn and beacon windows marked. (b)\nobreakspace  {}Disagreement $D(t)$ vs.\ the gauge-kernel component: the maneuver excites the former; only the beacon kills the latter; the acquisition spike in $D$ is the pin shock.}}{6}{}\protected@file@percent }
\newlabel{fig:heroseries}{{4}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-agent load-pose error at the 130\,s calibration horizon (recorded \texttt  {hero\_series.npz}): the beacon at agent\nobreakspace  {}0 (gold, from 30\,s) propagates through fusion to the whole fleet --- at this horizon. The 450\,s failure of this picture is the gain-starvation finding of Fig.\nobreakspace  {}7\hbox {}.}}{6}{}\protected@file@percent }
\newlabel{fig:agenterr}{{5}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-C}}The theorem's object, measured on both plants}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-D}}The closed-loop floor: the conjecture falsified, coherently}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-E}}Variance attribution: what makes up disagreement}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-F}}Symmetry: protection lives on the amplitude object}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The 50-transit scorecard at distribution level. (a)\nobreakspace  {}Fleet-mean dock error per arm (log scale --- B0's failure is two orders, not a tail). (b)\nobreakspace  {}Per-seed CDFs: the ordering holds seed-wise; the 0.5\,m spec (dotted) is left of every support. Seed-paired win counts in the strip.}}{6}{}\protected@file@percent }
\newlabel{fig:scorestats}{{6}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Hero v2 (decelerating approach), all 12 seeds sorted: fleet-mean vs.\ anchored-agent dock error. Median 0.62\,m, 17\% under spec --- improvement without sufficiency; the anchored agent is worse than the fleet mean on 11/12 seeds (gain starvation); best/median/worst marked, worst shown.}}{6}{}\protected@file@percent }
\newlabel{fig:v2seeds}{{7}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-G}}Cross-tier coefficients and the validity domain}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-H}}Numerics defense}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Error-transport holonomy amplitude on both plants. Thm\nobreakspace  {}7.2 (leading-order, deterministic): Tier-1 slope 1.999 with switch-offs at machine zero; Drake slope 2.000 with the $m{=}2$ coefficient check at 1.0000, the $\eta {=}0$ switch-off at machine zero, and the parallel class suppressing the coefficient $31\times $ (achieved-$\varepsilon $; exact cancellation remains the Tier-1 machine-zero result).}}{7}{}\protected@file@percent }
\newlabel{fig:f4a}{{8}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Tier-1/Tier-2 agreement on the conjectured steady-state floor ([ES\nobreakspace  {}\S  10(ii)]). Panel\nobreakspace  {}(a) separately tests the leading-order, deterministic holonomy amplitude of Thm\nobreakspace  {}7.2 in both tiers. With $D_0$ measured in situ by straight-tow controls, the fitted excess exponents are 1.101 [1.076, 1.125] (Tier-1) and 1.077 [1.054, 1.102] (Drake); the pre-registered equivalence test passes ($+0.023$ [$-0.012$, $+0.057$] $\subset $ [$-0.2$, $0.2$]) and the conjectured order\nobreakspace  {}2 is excluded on both plants. The fitted slope is a measured quantity in the conjectured regime, carried with the mixture caveat; the CIs exclude order\nobreakspace  {}1 as well, and no first-order law is asserted.}}{7}{}\protected@file@percent }
\newlabel{fig:f4b}{{9}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-I}}Robustness outside the protocol class (D10)}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces All Drake arms on matched formation draws. Ablating the conjugated transport (A2) runs $1.7\times \!\to \!8.2\times $ above the paper rule with growing $\tau $; naive consensus (A1) holds disagreement flat and low---by groupthink (anchored ANEES 62, drift 8.4\nobreakspace  {}m; baselines cell, 130\,s horizon): agreement alone is never a virtue metric. The straight-tow control shows the motion excitation ($19$--$21\times $ at every $\tau $).}}{7}{}\protected@file@percent }
\newlabel{fig:f4c}{{10}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Two objects, two panels, never mixed. (a)\nobreakspace  {}The amplitude departure from the symmetric class is first-order in $\varepsilon $ (measured 1.006, base commutator exactly zero). (b)\nobreakspace  {}The closed-loop floor excess: the seed-paired estimator gives slope 1.58 [1.44, 1.84] at every $\tau $ --- excluding both the conjectured 2 and 1; segment slopes rise 1.2\,$\to $\,2.1 up the ladder, consistent with a linear-plus-quadratic mixture that the registered single-power model mis-specifies.}}{7}{}\protected@file@percent }
\newlabel{fig:f5}{{11}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-J}}The adjudicated ledger, in one figure}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Connectivity buys agreement, not anchoring. The pre-anchor floor improves with $\lambda _2$ (a); single-anchor pinning is anchor-rate-limited (b, Spearman $+0.04$); re-agreement around the pin \emph  {anti}-orders with connectivity (c, $-0.51\,[-0.65, -0.36]$). With the in-domain contraction claim verified (Fig.\nobreakspace  {}13\hbox {}), this is the pre-registered ES-01 finding path, reported as such.}}{8}{}\protected@file@percent }
\newlabel{fig:d9}{{12}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Contraction in its own domain (frozen, unanchored): rate versus $\kappa \lambda _2$ across two topologies, slope 1.40 (falsifier $< 0.5$); $\mu $ calibrated at $\kappa = 0$, so the identity line is anchored, not predicted. The log-linearity remainder vanishes \emph  {faster} than the registered second order (2.48 [2.32, 2.65]; falsifier band excluded on the favorable side, reported as tripped with the corrected order).}}{8}{}\protected@file@percent }
\newlabel{fig:f8}{{13}{8}}
\@writefile{toc}{\contentsline {section}{\numberline {VIII}Discussion}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {VIII-}0a}The epistemic ladder as data.}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {\mbox  {VIII-}0b}What the ablations localize.}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces D10 robustness characterization (outside class $\mathcal  {P}$). (a)\nobreakspace  {}Floor vs.\ packet-drop probability, drops-only and drops+jitter arms (8 seeds each; mean $\pm $ sd): graceful, no red flags; anchored ANEES in-gate at $p{=}0.3$ at the 130\,s horizon. (b)\nobreakspace  {}Why the broadside guard never fired: $\hat  \sigma _i$ lags true broadside across the reachable gust envelope --- ON $\equiv $ OFF, reported as a null with its mechanism.}}{8}{}\protected@file@percent }
\newlabel{fig:robust}{{14}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces The multibody falsifier ledger, verdicts as adjudicated: green passed, red falsified / fired, orange anti-ordered. Grey marks registered references and equivalence bands; evidence record named per row. \textsc  {[conjectural]}{} rows report measured slopes as measured --- no law asserted.}}{8}{}\protected@file@percent }
\newlabel{fig:dforest}{{15}{8}}
